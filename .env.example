# 複製成 .env.local 後填入實際值（.env.local 不會進版控）
# 說明：specs/001-sermon-qa/plan.md §7

# 前端可讀取（必須以 QCLI_ 開頭）
QCLI_SUPABASE_URL=https://xxxx.supabase.co
QCLI_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx
QCLI_SITE_URL=http://localhost:9000
# supabase = 真實資料（預設）；mock = 假資料（只供本機示範）
QCLI_DATA_SOURCE=supabase
# 共用管理帳號的 Email（未設定時為 admin@echo.local），見 supabase/README.md
# QCLI_ADMIN_EMAIL=admin@echo.local

# 只在建置時使用：GitHub Pages 專案網址為 /echo/，自訂網域或本機為 /
BASE_PATH=/
